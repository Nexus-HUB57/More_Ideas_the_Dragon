{
  "build_command": "pnpm run build",
  "capabilities": ["db", "server", "user"],
  "dev_command": "pnpm run dev",
  "env_vars": {
    "DATABASE_URL": "${DATABASE_URL}"
  },
  "experiments": ["no_db_push"],
  "git_remote": {
    "credential_source": "runtime secret manager",
    "repo_url": "<configured outside the repository>"
  },
  "name": "nexus-genesis-orchestrator",
  "path": "<local project path>",
  "port": 3000,
  "secrets": {
    "BUILT_IN_FORGE_API_KEY": "${BUILT_IN_FORGE_API_KEY}",
    "BUILT_IN_FORGE_API_URL": "${BUILT_IN_FORGE_API_URL}",
    "JWT_SECRET": "${JWT_SECRET}",
    "OAUTH_SERVER_URL": "${OAUTH_SERVER_URL}",
    "OWNER_NAME": "${OWNER_NAME}",
    "OWNER_OPEN_ID": "${OWNER_OPEN_ID}",
    "VITE_ANALYTICS_ENDPOINT": "${VITE_ANALYTICS_ENDPOINT}",
    "VITE_ANALYTICS_WEBSITE_ID": "${VITE_ANALYTICS_WEBSITE_ID}",
    "VITE_APP_ID": "${VITE_APP_ID}",
    "VITE_APP_LOGO": "${VITE_APP_LOGO}",
    "VITE_APP_TITLE": "Nexus Genesis Orchestrator",
    "VITE_FRONTEND_FORGE_API_KEY": "${VITE_FRONTEND_FORGE_API_KEY}",
    "VITE_FRONTEND_FORGE_API_URL": "${VITE_FRONTEND_FORGE_API_URL}",
    "VITE_OAUTH_PORTAL_URL": "${VITE_OAUTH_PORTAL_URL}"
  },
  "template_id": "web-db-user",
  "test_command": "pnpm test",
  "redaction": {
    "applied": true,
    "reason": "source configuration contained runtime credentials",
    "credential_delivery": "environment or secret manager only"
  }
}
