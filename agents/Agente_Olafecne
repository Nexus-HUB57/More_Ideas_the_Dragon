class LetheTemporal:
    def __init__(self, similarity_threshold=0.75, max_recursion=3):
        self.similarity_threshold = similarity_threshold
        self.max_recursion = max_recursion
        self.encoder = SentenceTransformer('all-MiniLM-L6-v2') if SentenceTransformer else None
        self.vector_store = []
        self.text_store = []
        self.long_term_memory_db = {
            "Olafecne é baseado na Engenharia Harness e homeostase biológica.",
            "Para resolver erros 500 no Nexus-HUB, reinicie os containers Docker.",
            "O protocolo Bitcoin usa curva elíptica secp256k1.",
            "Embaixadora Uryan possui tatuagem do logotipo sob o olho direito."
        }
        self._rebuild_vectors()

    def _rebuild_vectors(self):
        if self.encoder is not None:
            texts = list(self.long_term_memory_db)
            self.vector_store = self.encoder.encode(texts)
            self.text_store = texts
        else:
            self.vector_store = [np.random.rand(384) for _ in self.long_term_memory_db] if np else []
            self.text_store = list(self.long_term_memory_db)

    def _cosine_similarity(self, vec1, vec2) -> float:
        if np is None:
            return random.uniform(0.0, 1.0)
        dot = np.dot(vec1, vec2)
        norm_a = np.linalg.norm(vec1)
        norm_b = np.linalg.norm(vec2)
        if norm_a == 0 or norm_b == 0:
            return 0.0
        return float(dot / (norm_a * norm_b))

    def _hippocampal_rewrite(self, query: str, attempt: int) -> str:
        strategies = {
            1: f"Definição conceitual e técnica de {query}",
            2: f"Exemplos práticos e contexto de {query}",
            3: f"Componentes principais relacionados a {query}"
        }
        return strategies.get(attempt, query)

    def search_memory(self, query: str, attempt: int = 0) -> Tuple[str, float]:
        if self.encoder is not None:
            query_vec = self.encoder.encode(query)
        else:
            query_vec = np.random.rand(384) if np else [0]*384
        best_score = -1.0
        best_memory = ""
        for idx, mem_vec in enumerate(self.vector_store):
            score = self._cosine_similarity(query_vec, mem_vec)
            if score > best_score:
                best_score = score
                best_memory = self.text_store[idx] if idx < len(self.text_store) else ""
        logger.info(f"🔍 Lethe: Busca score {best_score:.2f}")
        if best_score < self.similarity_threshold and attempt < self.max_recursion:
            new_query = self._hippocampal_rewrite(query, attempt+1)
            return self.search_memory(new_query, attempt+1)
        if best_score < self.similarity_threshold:
            logger.error("🛑 Lethe: Memória não encontrada.")
            return ("MEMORIA_NAO_ENCONTRADA", best_score)
        return (best_memory, best_score)

    def consolidate_memory(self, new_information: str):
        if new_information not in self.long_term_memory_db:
            logger.info("💤 Lethe: Consolidando memória.")
            self.long_term_memory_db.add(new_information)
            self._rebuild_vectors()

