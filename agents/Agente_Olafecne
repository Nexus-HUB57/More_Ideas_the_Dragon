class HarmoniaCerebellumOutlines:
    """Cerebelo usando Outlines para forçar saída JSON estrita."""
    def __init__(self, model_path: str = DEFAULT_MODEL_PATH, fallback: bool = False):
        self.fallback = fallback
        self.bias_threshold = 0.15
        self.model = None
        self.generator = None
        if outlines is not None and not fallback:
            try:
                self.model = models.llamacpp(model_path, n_ctx=2048)
                self.generator = generate.json(self.model, TonusSemantico)
                logger.info("⚙️ Cerebelo Outlines inicializado com sucesso.")
            except Exception as e:
                logger.warning(f"⚠️ Falha ao carregar Outlines: {e}. Usando fallback.")
                self.fallback = True
        else:
            self.fallback = True
            logger.info("⚙️ Cerebelo em modo fallback (simulação).")

    def pid_controller_semantics(self, draft_text: str) -> str:
        if self.fallback:
            # Simulação simples (como na versão anterior)
            bias = 0.05 if "equilibrado" in draft_text.lower() else 0.20
            if bias > self.bias_threshold:
                return f"[EXECUÇÃO POLIDA E MITIGADA] {draft_text.replace('agressivo','calibrado')}"
            return f"[EXECUÇÃO POLIDA] {draft_text}"

        prompt = f"Avalie a racionalidade e refine o seguinte texto bruto: '{draft_text}'"
        try:
            resultado = self.generator(prompt)
            if resultado.viés_detectado and resultado.racionalidade_score < (1 - self.bias_threshold):
                return f"[EXECUÇÃO POLIDA E MITIGADA]: {resultado.saida_polida} (Mitigação: {resultado.acao_mitigadora})"
            return f"[EXECUÇÃO POLIDA]: {resultado.saida_polida}"
        except Exception as e:
            logger.error(f"Erro no Cerebelo Outlines: {e}. Usando fallback.")
            return draft_text

