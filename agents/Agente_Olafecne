        # Cerebelo (Outlines) polindo a saída
        final_output = self.cerebellum.pid_controller_semantics(raw_output)

        logger.info("[CICLO CONCLUÍDO] Homeostase mantida.")
        return final_output

    async def process_stimulus(self, task: str, websocket=None) -> str:
        return await self.metabolic_cycle(task, websocket)

