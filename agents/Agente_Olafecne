        self.spinal_cord.subscribe("EXTERNAL_DATA_INGESTED", self._external_data_listener)

        self.is_awake = True
        self.working_memory = {}

    async def _synaptic_listener(self, payload):
        logger.info(f"⚡ Medula: Nova sinapse: {payload.get('new_rule', '')[:50]}...")
        self.working_memory["latest_rule"] = payload.get("new_rule")

