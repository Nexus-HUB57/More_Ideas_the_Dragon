# 4. SISTEMA rRNA COM DSPy (AUTO‑CURA GENÉTICA)
# =====================================================================
class RnaPulseSystemDSPy:
    """rRNA que usa DSPy para mutar prompts com base em erros."""
    def __init__(self, bus, use_dspy: bool = True, lm_model: str = "ollama/llama3"):
        self.bus = bus
        self.use_dspy = use_dspy and (dspy is not None)
        self.known_mutations = {}

        if self.use_dspy:
            # Configura o DSPy com um LM (pode ser trocado para LlamaCpp local)
            try:
                dspy.settings.configure(lm=dspy.LM(lm_model))
                self.mutator = dspy.ChainOfThought("prompt_original, erro_fatal -> prompt_curado")
                logger.info("🧬 rRNA DSPy inicializado com sucesso.")
            except Exception as e:
                logger.warning(f"⚠️ Falha ao configurar DSPy: {e}. Usando fallback.")
                self.use_dspy = False
        else:
            logger.info("🧬 rRNA em modo fallback (simulação).")

    def detect_necrosis(self, execution_result: Dict[str, Any]) -> bool:
        if execution_result.get("status") == "FAIL":
            logger.error(f"🦠 rRNA: Necrose detectada em {execution_result.get('module')}")
            return True
        return False

    async def trigger_exponential_healing(self, failed_payload: Dict[str, Any]) -> str:
        """Gera uma mutação curada usando DSPy ou fallback."""
        erro = failed_payload.get("error", "Alucinação Semântica Crítica")
        prompt_ruim = failed_payload.get("raw_input", "")

        if self.use_dspy and self.mutator:
            try:
                # DSPy gera o anticorpo
                resposta = self.mutator(prompt_original=prompt_ruim, erro_fatal=erro)
                cured_prompt = resposta.prompt_curado
                logger.info(f"💉 rRNA (DSPy): Cura gerada: {cured_prompt[:100]}...")
            except Exception as e:
                logger.error(f"Erro no DSPy: {e}. Usando fallback.")
                cured_prompt = self._fallback_mutation(prompt_ruim, erro)
        else:
            cured_prompt = self._fallback_mutation(prompt_ruim, erro)

        # Viraliza a cura
        mutation_id = str(uuid.uuid4())[:8]
        self.known_mutations[mutation_id] = cured_prompt
        await self.bus.broadcast("SYNAPTIC_UPDATE", {"new_rule": cured_prompt})
        logger.info(f"✨ rRNA: Cura viralizada. ID: {mutation_id}")
        return cured_prompt

    def _fallback_mutation(self, prompt: str, erro: str) -> str:
        """Mutação simples quando DSPy não está disponível."""
        return prompt + f" [INSTRUÇÃO ADICIONAL: Evitar {erro} e validar entradas]"

    def otimizar_genoma(self, conjunto_de_testes):
        """Otimiza o mutator com BootstrapFewShot (opcional)."""
        if self.use_dspy and BootstrapFewShot is not None:
            try:
                teleprompter = BootstrapFewShot(metric=self._metrica_homeostase, max_bootstrapped_demos=4)
                self.mutator = teleprompter.compile(self.mutator, trainset=conjunto_de_testes)
                logger.info("🧬 rRNA: Genoma otimizado via BootstrapFewShot.")
            except Exception as e:
                logger.warning(f"Falha na otimização: {e}")

    def _metrica_homeostase(self, example, pred, trace=None):
        # Métrica simples: se o prompt_curado não contém o erro, consideramos sucesso
        return 1.0 if "erro" not in pred.prompt_curado.lower() else 0.0

