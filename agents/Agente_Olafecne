    async def metabolic_cycle(self, stimulus: str, websocket=None) -> str:
        logger.info(f"\n[ESTÍMULO]: {stimulus}")

        self.diencephalon.regulate()
        memory_content, confidence = self.temporal_lobe.search_memory(stimulus)

